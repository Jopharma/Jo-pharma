import React, { useState, useEffect } from 'react';

export default function JoPharmaApp() {
  const [data, setData] = useState({ medicines: [], herbs: [], diseases: [] });
  const [activeTab, setActiveTab] = useState('medicines');
  const [searchTerm, setSearchTerm] = useState('');
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    // جلب الملف محلياً من مجلد الـ public بسرعة خيالية
    fetch('/jopharma_data.json')
      .then(res => res.json())
      .then(jsonData => {
        setData(jsonData);
        setLoading(false);
      })
      .catch(err => {
        console.error("Error loading local data:", err);
        setLoading(false);
      });
  }, []);

  // تصفية العناصر بناءً على البحث والتاب الحالي
  const currentItems = data[activeTab] || [];
  const filteredItems = currentItems.filter(item => 
    (item.name && item.name.toLowerCase().includes(searchTerm.toLowerCase())) ||
    (item.category && item.category.toLowerCase().includes(searchTerm.toLowerCase()))
  );

  return (
    <div className="min-h-screen bg-gray-50 p-4 md:p-8" dir="rtl">
      <div className="max-w-6xl mx-auto">
        <h1 className="text-3xl font-extrabold text-emerald-800 text-center mb-2">موقع JOPharma الدوائي</h1>
        <p className="text-center text-gray-600 mb-8">قاعدة البيانات الطبية الشاملة (أدوية، أعشاب، وأمراض - محلي 100%)</p>

        {/* أزرار التبديل بين الأقسام */}
        <div className="flex justify-center gap-2 md:gap-4 mb-6">
          <button 
            onClick={() => { setActiveTab('medicines'); setSearchTerm(''); }}
            className={`px-5 py-2.5 rounded-xl font-bold transition shadow-sm ${activeTab === 'medicines' ? 'bg-emerald-600 text-white' : 'bg-white text-gray-700 hover:bg-emerald-50'}`}
          >
            💊 الأدوية والأسعار
          </button>
          <button 
            onClick={() => { setActiveTab('herbs'); setSearchTerm(''); }}
            className={`px-5 py-2.5 rounded-xl font-bold transition shadow-sm ${activeTab === 'herbs' ? 'bg-emerald-600 text-white' : 'bg-white text-gray-700 hover:bg-emerald-50'}`}
          >
            🌿 الأعشاب الطبية
          </button>
          <button 
            onClick={() => { setActiveTab('diseases'); setSearchTerm(''); }}
            className={`px-5 py-2.5 rounded-xl font-bold transition shadow-sm ${activeTab === 'diseases' ? 'bg-emerald-600 text-white' : 'bg-white text-gray-700 hover:bg-emerald-50'}`}
          >
            🩺 دليل الأمراض
          </button>
        </div>

        {/* خانة البحث السريع */}
        <div className="mb-8 max-w-md mx-auto">
          <input 
            type="text"
            placeholder="ابحث عن اسم دواء، عشبة، أو مرض..."
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            className="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 shadow-sm bg-white"
          />
        </div>

        {/* عرض المحتوى أو التحميل */}
        {loading ? (
          <div className="text-center py-20 text-emerald-600 font-semibold text-lg">جاري تحميل قاعدة البيانات الطبية...</div>
        ) : (
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {filteredItems.length > 0 ? (
              filteredItems.map((item, index) => (
                <div key={item.id || index} className="bg-white p-6 rounded-2xl shadow-md border border-emerald-100 hover:shadow-lg transition flex flex-col justify-between">
                  <div>
                    <div className="flex justify-between items-start mb-3">
                      <h3 className="text-lg font-bold text-emerald-900">{item.name}</h3>
                      {item.price > 0 && (
                        <span className="bg-emerald-100 text-emerald-800 text-xs font-bold px-2.5 py-1 rounded-full">
                          {item.price} د.أ
                        </span>
                      )}
                    </div>
                    
                    {item.category && (
                      <span className="inline-block bg-gray-100 text-gray-600 text-xs px-2.5 py-1 rounded-md mb-3">
                        {item.category}
                      </span>
                    )}

                    <p className="text-gray-600 text-sm leading-relaxed mb-3">
                      {item.description}
                    </p>

                    {/* تفاصيل طريقة الاستعمال للأعشاب */}
                    {item.usage_method && (
                      <div className="bg-emerald-50 p-3 rounded-xl mb-3 text-xs text-emerald-900">
                        <strong className="block mb-1">طريقة الاستعمال:</strong>
                        {item.usage_method}
                      </div>
                    )}

                    {/* الآلية المرضية للأمراض */}
                    {item.scientific_pathology && (
                      <div className="bg-blue-50 p-3 rounded-xl mb-3 text-xs text-blue-900">
                        <strong className="block mb-1">الآلية المرضية والإمراضيات:</strong>
                        {item.scientific_pathology}
                      </div>
                    )}
                  </div>

                  {item.alternatives && (
                    <div className="pt-3 border-t border-gray-100 text-xs text-gray-500 mt-2">
                      <strong>البدائل:</strong> {item.alternatives}
                    </div>
                  )}
                </div>
              ))
            ) : (
              <div className="col-span-full text-center py-12 text-gray-500">
                لا توجد نتائج مطابقة لبحثك.
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  );
}
